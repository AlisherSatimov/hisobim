# Supabase ulanish sozlamalari
# Bu faylni nusxalab, ilova papkalarida .env yarating:
#   cp .env.example apps/mobile/.env
#   cp .env.example apps/web/.env
#
# Mobil ilova EXPO_PUBLIC_ prefiksini, veb ilova VITE_ prefiksini o'qiydi.
# Ikkalasi ham bitta Supabase loyihasiga ulanadi.

EXPO_PUBLIC_SUPABASE_URL=https://<loyiha-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<kalit>

VITE_SUPABASE_URL=https://<loyiha-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<kalit>
